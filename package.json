{
  "name": "mpc-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Seed/admin tooling for The Messy Parents Collection guides.",
  "scripts": {
    "build": "node scripts/build.js",
    "verify": "node tests/verify.js && node tests/age-visibility.js && node tests/runtime-sim.js && npm run verify:social",
    "verify:social": "node tests/social-publishing-lock.js && node tests/social-safety.js && node tests/social-approval.js",
    "check": "node scripts/build.js && npm run verify",
    "seed": "node seed.js",
    "serve": "node tests/static-server.js",
    "test": "playwright test",
    "test:report": "playwright show-report test-results/html",
    "audit": "playwright test && node -e \"process.stdout.write(require('fs').readFileSync('test-results/audit-report.md','utf8'))\"",
    "audit:standalone": "node tests/run-audit.js",
    "verify:static": "node tests/verify.js",
    "verify:runtime": "node tests/runtime-sim.js",
    "verify:ages": "node tests/age-visibility.js",
    "social:render": "node scripts/social-render.js"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0"
  }
}
