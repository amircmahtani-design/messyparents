rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Uploaded images — guide illustrations, page illustrations, book covers,
    // and topic icons. Public to read, writable only by a signed-in admin.
    match /guides/{file=**} { allow read: if true; allow write: if request.auth != null; }
    match /pages/{file=**}  { allow read: if true; allow write: if request.auth != null; }
    match /books/{file=**}  { allow read: if true; allow write: if request.auth != null; }
    match /icons/{file=**}  { allow read: if true; allow write: if request.auth != null; }

    // Tighter option — restrict writes to your admin email, e.g.:
    //   allow write: if request.auth != null
    //     && request.auth.token.email == "amircmahtani@gmail.com";
  }
}
