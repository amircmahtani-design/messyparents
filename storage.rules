rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Admin = the one account allowed to upload anything.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "amircmahtani@gmail.com";
    }

    // Public site images — guide illustrations, page illustrations, book
    // covers on the Our Books page, topic icons, and the pictures attached to
    // editable site text. Anyone may read; only the admin may upload.
    match /guides/{file=**}   { allow read: if true; allow write: if isAdmin(); }
    match /pages/{file=**}    { allow read: if true; allow write: if isAdmin(); }
    match /books/{file=**}    { allow read: if true; allow write: if isAdmin(); }
    match /icons/{file=**}    { allow read: if true; allow write: if isAdmin(); }
    match /sitetext/{file=**} { allow read: if true; allow write: if isAdmin(); }

    // Character reference art, moved out of the repo. It must stay publicly
    // readable: Studio hands these URLs to the illustration API, which fetches
    // them itself and cannot sign in as you.
    match /refs/{file=**}     { allow read: if true; allow write: if isAdmin(); }

    // Generated social artwork. Written ONLY by the Admin SDK inside
    // netlify/functions/social-artwork.js — `allow write: if false` means a
    // signed-in browser console cannot put a picture into a package any more
    // than it can approve one.
    //
    // Readable, like the book images and for the same reason: the /social/
    // dashboard shows these in <img> tags on a page that cannot mint a
    // Storage token, and the export renderer has to fetch them without one.
    // What protects them is the path, not the wall — every file is
    // social/<packageId>/<kind>-<n>-<16 hex of the content key>.png, and the
    // key is a SHA-256 of the guide, the family, the variant, the reference
    // ids and the prompt version (see scripts/lib/social/artwork.js). These
    // are also images intended for a public feed once publishing is enabled;
    // nothing private is in them, because nothing readable is in them at all.
    match /social/{file=**}   { allow read: if true; allow write: if false; }

    // Pictures used inside the book (the Editor). The manuscript text is fully
    // private in Firestore; these files sit behind long unguessable download
    // URLs rather than the sign-in wall, because the <img> tags in the editor
    // and in the exported PDF have to load them without a token exchange.
    match /book/{file=**}     { allow read: if true; allow write: if isAdmin(); }
  }
}
