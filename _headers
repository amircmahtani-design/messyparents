# Netlify cache rules.
#
# Images, fonts and icons never change without changing their filename, so they
# can be cached hard. HTML must not be, or a deploy would not reach anyone who
# had visited before.

/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

# The three faces, self-hosted since August 2026. Same rule as images: the
# filename carries the identity, so a year is safe. Replacing a face means
# giving the file a new name, exactly as with an illustration.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# CSS and JS used to be cached for a week with hand-maintained ?v=11 query
# strings, which had already drifted out of step between pages (guides.js was
# ?v=9 on four pages and ?v=10 on two). Every reference is now stamped by
# scripts/build.js with a hash of the file's actual contents, so the URL
# changes if and only if the file does. That makes a year safe: a returning
# reader re-downloads a stylesheet only when it has genuinely changed, and gets
# the new one immediately when it has, with no version bump to remember.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

# The generated public data files. These are NOT fingerprinted — the pages
# fetch them by a fixed name — so they must revalidate, or a newly published
# guide would be missing from search until a browser cache expired.
#
# stale-while-revalidate is what makes that cheap: the browser uses its copy
# immediately and refreshes it in the background, so a search never waits for
# the network but is never far behind either.
/data/*.json
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

# The build-time fallback catalogue. Not referenced by any public page — only
# by the Netlify build and by Studio — but it is in the published tree, so it
# is explicitly kept out of the index.
/data/guides-bundle.js
  X-Robots-Tag: noindex, nofollow

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Generated guide, topic and age pages are HTML: they must revalidate, or a
# deploy would never reach anyone who had already visited.
/guides/*
  Cache-Control: public, max-age=0, must-revalidate

/topics/*
  Cache-Control: public, max-age=0, must-revalidate

/ages/*
  Cache-Control: public, max-age=0, must-revalidate

# Crawler-facing files. Short cache so a freshly published guide is discoverable
# quickly, but not so short that every crawl is a cold fetch.
/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

# The audit is disallowed in robots.txt and carries a noindex meta tag. This is
# the third layer: an HTTP header, which applies even if the page is fetched by
# something that ignores both.
/seo-audit.html
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

# The two editing surfaces are not public content.
/studio/*
  X-Robots-Tag: noindex, nofollow

/editor/*
  X-Robots-Tag: noindex, nofollow

# Illustration reference sheets: 20MB of source material for the
# image-generation pipeline, fetched by Studio and by the Netlify functions
# from the deployed origin, so they cannot simply be deleted without breaking
# generation. No public page requests them and nothing should index them.
# Studio has a tool to move them to Firebase Storage; until that is run, this
# at least keeps them out of search results.
/assets/img/refs/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=31536000, immutable
