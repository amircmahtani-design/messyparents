rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Guides: public to read, writable only by the signed-in admin.
    match /guides/{id} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == "amircmahtani@gmail.com";
    }

    // Illustration jobs: the signed-in admin reads status; only the server
    // (Firebase Admin SDK, which bypasses these rules) writes them.
    match /illustration_jobs/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
