rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Guides: public to read, writable only by the signed-in admin.
    match /guides/{id} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == "amircmahtani@gmail.com";
    }

    // Pages: per-page hero image + optional title/subtitle. Public read,
    // writable only by the signed-in admin (same as guides).
    match /pages/{id} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == "amircmahtani@gmail.com";
    }

    // Site meta: the editable browse topics (meta/topics) and the Our Books
    // list (meta/books). Public read, writable only by the signed-in admin.
    match /meta/{id} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == "amircmahtani@gmail.com";
    }

    // The book manuscript (the Editor). Unlike everything above, this is NOT
    // publicly readable — only the admin account can read or write it, so the
    // book stays private even though /editor/ sits on a public host.
    match /book/{id} {
      allow read, write: if request.auth != null
        && request.auth.token.email == "amircmahtani@gmail.com";
    }

    // Illustration jobs: the admin reads status; only the server (admin SDK) writes.
    match /illustration_jobs/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Character sessions (the Character Manager): admin reads + can reset a session;
    // the server (admin SDK, which bypasses rules) does the normal writes.
    match /character_sessions/{key} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email == "amircmahtani@gmail.com";
    }
  }
}
