rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Guides: readable by the public site, writable only by a signed-in admin.
    match /guides/{id} {
      allow read: if true;
      allow write: if request.auth != null;

      // Tighter option — restrict writes to a specific admin account:
      // allow write: if request.auth != null
      //   && request.auth.token.email == "you@example.com";
    }
  }
}
